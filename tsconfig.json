{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "extension",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vscode"],
    "skipLibCheck": false
  },
  "include": ["extension/**/*.ts"]
}
